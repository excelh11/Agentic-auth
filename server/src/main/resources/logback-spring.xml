<?xml version="1.0" encoding="UTF-8"?>
<!--
    F13 — 감사 로그(위임자/행위자 짝 기록)를 위한 별도 설정.

    "com.agenticauth.audit" 로거로 남긴 로그(DelegationValidator)는 콘솔뿐 아니라
    logs/audit.log 에도 따로 쌓인다. 일반 애플리케이션 로그와 섞이지 않아야
    "act가 있는 요청(위임 호출)과 없는 요청(본인 호출)이 기록만 보고 구분 가능해야 한다"(F13-2)는
    요구를 만족하기 쉽다.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- F13 감사 로그 전용 파일 — 위임자/행위자/호출 API -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/audit.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [AUDIT] %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/audit.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <logger name="com.agenticauth.audit" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
